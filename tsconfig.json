{
  "compilerOptions": {
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "./src",      
    "module": "ES2022",    
    "moduleResolution": "node", 
    "esModuleInterop": true,  
    "forceConsistentCasingInFileNames": true,    
    "strict": true,      
    "skipLibCheck": true      
  }
}
